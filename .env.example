# ==============================================================================
# Oracle Private Hire - Environment Configuration Template
# Copy this file to '.env' and fill in your production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Database Connection
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection String (Make sure to include your cluster subdomain)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.<subdomain>.mongodb.net/oracle_private_hire?retryWrites=true&w=majority&appName=Cluster0"

# ------------------------------------------------------------------------------
# 2. Authentication & Admin Credentials
# ------------------------------------------------------------------------------
# Secret key used for signing JWT session tokens
JWT_SECRET="oracle-private-hire-super-secret-key-2025"

# Initial Super Admin Login Details
ADMIN_USERNAME="admin"
ADMIN_EMAIL="rxasif31@gmail.com"
ADMIN_PASSWORD="your_secure_password_here"

# ------------------------------------------------------------------------------
# 3. Stripe Payment Gateway (Card Payments, Apple Pay, Google Pay)
# ------------------------------------------------------------------------------
# Stripe Publishable Key (Public - exposed to browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"

# Stripe Secret Key (Private - server only)
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"

# Stripe Webhook Signing Secret (Optional for local, recommended for production)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# ------------------------------------------------------------------------------
# 4. Nodemailer & Email Dispatch Configuration
# ------------------------------------------------------------------------------
# Option A: Google Cloud Console OAuth2 (Recommended for Google Cloud)
GMAIL_USER="rxasif04@gmail.com"
GMAIL_CLIENT_ID="your_google_cloud_client_id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your_google_cloud_client_secret"
GMAIL_REFRESH_TOKEN="your_google_cloud_oauth_refresh_token"

# Option B: Standard SMTP / Google 16-character App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="rxasif04@gmail.com"
SMTP_PASS="your_16_digit_app_password"

# Sender and Notification Headers
SMTP_FROM='"Oracle Private Hire" <rxasif04@gmail.com>'
NOTIFICATION_EMAIL="rxasif31@gmail.com"

# ------------------------------------------------------------------------------
# 5. Application URL
# ------------------------------------------------------------------------------
# Base URL of the website (Change to your live domain in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
